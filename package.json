{
    "name": "retrium",
    "version": "0.1.0",
    "description": "A cross-platform application to organise your collection of old programs for DOSBox.",
    "keywords": [
        "dos",
        "dosbox",
        "tauri"
    ],
    "author": {
        "name": "Garrett HE",
        "email": "garrett.he@outlook.com"
    },
    "homepage": "https://github.com/garrett-he/retrium#readme",
    "bugs": {
        "url": "https://github.com/garrett-he/retrium/issues",
        "email": "garrett.he@outlook.com"
    },
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/garrett-he/retrium.git"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "simple-git-hooks",
        "tauri": "tauri"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^5.18.0",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-opener": "^2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router-dom": "^7.6.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@tauri-apps/cli": "^2",
        "@testing-library/jest-dom": "^6.6.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^4.4.0",
        "@vitest/coverage-v8": "^4.1.8",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.0.7",
        "simple-git-hooks": "^2.13.1",
        "typescript": "~5.7.0",
        "vite": "^6.3.0",
        "vitest": "^4.1.8"
    },
    "engines": {
        "node": ">=22"
    },
    "private": true,
    "packageManager": "pnpm@11.6.0",
    "lint-staged": {
        "*": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    }
}
